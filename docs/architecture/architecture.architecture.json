  "cards": [
    {
      "dot": "cyan",
      "title": "Runtime contract",
      "items": [
        "CLI and server operate on tokens, logits, and sessions; tensor layouts stay inside the engine.",
        "The current server and session operations fail closed until their delivery gates pass."
      ]
    },
    {
      "dot": "emerald",
      "title": "Model execution",
      "items": [
        "64-layer hybrid Qwen3.8 schedule: 48 GDN layers plus 16 full-attention layers.",
        "BF16 activations, FP32 sensitive accumulation, FP32 logits, and two-byte KV storage are planned."
      ]
    },
    {
      "dot": "violet",
      "title": "Trust & ownership",
      "items": [
        "The host process owns API validation, artifact admission, session state, and persistence.",
        "CUDA execution is isolated behind the device boundary; external authorities are provenance and test inputs, not runtime services."
      ]
    },
    {
      "dot": "amber",
      "title": "External dependencies",
      "items": [
        "Pinned GGUF and tokenizer metadata are admitted only by exact size, contract, tensor inventory, and SHA-256 checks.",
        "CUDA 13.0 Docker, utf8proc, Transformers, llama.cpp, vLLM, and Ollama support build, semantics, diagnostics, or comparison."
      ]
    }
  ]
