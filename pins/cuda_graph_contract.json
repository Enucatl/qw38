{
  "schema_version": 1,
  "task": "OPT-003",
  "target": "sm_120",
  "toolkit": "CUDA 13.0.2",
  "scope": {
    "graphs": 64,
    "boundary": "one stable-address fused FFN graph per decoder layer",
    "included": [
      "FFN input norm",
      "gate projection",
      "up projection",
      "SwiGLU",
      "down projection",
      "fused residual/next-input norm"
    ],
    "excluded_dynamic": [
      "embedding token row",
      "GDN state-owner swap",
      "attention position and causal extent",
      "KV destination",
      "host output copies",
      "atomic commit"
    ]
  },
  "ownership": {
    "binding": "exact ResidentModel and SchedulerWorkspace object addresses",
    "production_path": "graph",
    "retained_reference": "ordinary fused launches",
    "mismatch_policy": "fail before execution"
  },
  "admission": {
    "logits_exact": true,
    "hidden_exact": true,
    "trace_taps_exact": true,
    "session_state_exact": true,
    "greedy_exact": true,
    "minimum_warmups": 3,
    "minimum_paired_samples": 30,
    "graph_allocation_must_be_measured": true
  }
}
