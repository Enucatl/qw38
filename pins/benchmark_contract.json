{
  "schema": "qw38.benchmark-contract.v1",
  "task": "BEN-001",
  "production_binary": "build/cuda/qw38-bench",
  "host_binary_scope": "argument, statistics, and failure-record validation",
  "cuda_architecture": "sm_120",
  "model_sha256": "31629f53165ab6a7dad8c9847dcfd1fdf55829dac1e6e748f4a68581b0033d34",
  "minimum_warmups": 3,
  "minimum_samples": 30,
  "primary_cache_policy": "disabled",
  "separate_cache_policy": "agent-reuse",
  "workloads": {
    "prefill": [
      128,
      2048,
      8192
    ],
    "decode_context": [
      128,
      2048,
      8192,
      32768,
      131072
    ],
    "decode_output_tokens": 256,
    "maximum_decode_prompt_tokens": 130815
  },
  "required_identity": [
    "model SHA-256",
    "prompt SHA-256",
    "rendered token IDs",
    "expected prompt-token count",
    "source revision",
    "clean source state",
    "container digest",
    "CUDA versions",
    "GPU identity"
  ],
  "required_raw_data": [
    "every warm-up outcome",
    "every measured sample outcome",
    "per-token decode wall times",
    "generated token IDs",
    "telemetry snapshots",
    "failed-run status and error"
  ],
  "summary_metrics": [
    "prefill milliseconds p50/p95",
    "prompt tokens/second p50/p95",
    "time to first token p50/p95",
    "inter-token latency p50/p95",
    "output tokens/second p50/p95",
    "peak observed device memory",
    "peak host RSS"
  ],
  "component_probe": {
    "separate_from_throughput_samples": true,
    "perturbs_execution": true,
    "categories": [
      "loading",
      "embedding",
      "GDN",
      "attention",
      "FFN",
      "logits",
      "sampling",
      "graph launch",
      "queueing",
      "persistence",
      "idle gaps",
      "state commit",
      "token total"
    ]
  },
  "admission": {
    "smoke_mode_is_eligible": false,
    "failed_runs_are_retained": true,
    "atomic_result_publication": true,
    "unsupported_values_are_null": true
  }
}
