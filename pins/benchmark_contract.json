      "FFN",
      "logits",
      "sampling",
      "graph launch",
      "queueing",
      "persistence",
      "idle gaps",
      "state commit",
      "token total"
    ]
  },
  "admission": {
    "smoke_mode_is_eligible": false,
    "failed_runs_are_retained": true,
    "atomic_result_publication": true,
    "unsupported_values_are_null": true
